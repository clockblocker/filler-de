{
	"author": "clockblocker",
	"dependencies": {
		"@codemirror/view": "latest",
		"@textfresser/dictionary": "workspace:*",
		"@textfresser/lemma-note-codec": "workspace:*",
		"@textfresser/lemma-note-projections": "workspace:*",
		"@textfresser/library-core": "workspace:*",
		"@textfresser/note-addressing": "workspace:*",
		"@textfresser/obsidian-event-layer": "workspace:*",
		"@textfresser/vault-action-manager": "workspace:*",
		"emoji-regex": "^10.6.0",
		"jsonc-parser": "^3.3.1",
		"neverthrow": "^8.2.0",
		"zod": "4.4.3"
	},
	"description": "Go trough the german texts, building your own dictionary from your personal contexts",
	"devDependencies": {
		"@biomejs/biome": "^2.2.6",
		"@effect/tsgo": "0.56.0",
		"@types/bun": "latest",
		"@types/node": "^18.19.130",
		"@typesafe-ai/sdk": "^0.6.0",
		"bun-types": "^1.3.4",
		"effect": "4.0.0",
		"knip": "^6.33.0",
		"obsidian": "^1.10.2",
		"oxc-parser": "0.147.0",
		"oxlint": "1.89.0",
		"oxlint-tsgolint": "7.0.2004",
		"ts-plugin-sort-import-suggestions": "github:clockblocker/ts7-plugin-sort-import-suggestions",
		"typescript": "^7.0.2",
		"yaml": "2.9.0"
	},
	"keywords": [],
	"license": "MIT",
	"main": "main.js",
	"name": "cbcr-text-eater-de",
	"scripts": {
		"batteries:report": "bun scripts/link-texteater.ts --report",
		"batteries:sync": "bun scripts/sync-texteater.ts",
		"build": "bun run batteries:report && bun run build:root",
		"build:dev": "bun x tsc --noEmit && bun run dev",
		"build:full": "bun run build",
		"build:root": "bun scripts/live-build-guard.ts && bun build ./src/main.ts --outfile=main.js --platform=node --format=cjs --conditions=convex --tsconfig-override=tsconfig.json --external obsidian --external electron --external @codemirror/*",
		"clearTestLogs": "bun ./tests/tracing/scripts/clear-test-logs.ts",
		"coverage": "bun run clearTestLogs && bun test --tsconfig-override=tsconfig.json --coverage --preload ./tests/unit/setup.ts",
		"dev": "bun run batteries:report && bun run build:root --watch --sourcemap=inline",
		"fix": "bun x biome check --write --unsafe . 2>/dev/null || true",
		"gauge:effect": "bun scripts/effect-gauge.ts",
		"knip": "knip",
		"link:texteater": "bun scripts/link-texteater.ts",
		"lint": "bun x biome check .",
		"lint:ox": "oxlint",
		"postinstall": "bun scripts/link-texteater.ts --warn-only",
		"prepare": "effect-tsgo patch --oxlint --skip-missing",
		"runbook": "bash scripts/runbook-cli/textfresser-runbook",
		"splitter:run": "bun tests/splitter-runner.ts",
		"test": "bun run test:unit",
		"test:integration": "bun test --tsconfig-override=tsconfig.json --preload ./tests/unit/setup.ts src/packages/composed/library-core/tests/integration/ src/packages/composed/dictionary/tests/integration/ tests/integration/",
		"test:obsidian-e2e": "bun run build && bun --env-file=.env.obsidian-e2e --env-file=.env.cli-e2e tests/obsidian-e2e/runner.ts --mode=attached",
		"test:obsidian-e2e:infra": "bun test tests/obsidian-e2e/infra tests/obsidian-e2e/driver --timeout 10000",
		"test:obsidian-e2e:managed": "bun run build && OBSIDIAN_E2E_MODE=managed bun tests/obsidian-e2e/runner.ts",
		"test:provider-acceptance:dumgen": "bun --tsconfig-override=tsconfig.json tests/provider-acceptance/dumgen/run.ts",
		"test:provider-acceptance:preflight": "bun test --tsconfig-override=tsconfig.json tests/provider-acceptance/dumgen/preflight.test.ts --path-ignore-patterns='__textfresser_no_ignored_test_paths__/**'",
		"test:unit": "bun run clearTestLogs && bun test --tsconfig-override=tsconfig.json --reporter=dot --preload ./tests/unit/setup.ts src/packages/independent/*/tests/ src/packages/composed/*/tests/ tests/unit/ tests/integration/ tests/specs/",
		"typecheck": "bun x tsc --noEmit",
		"typecheck:changed": "bash scripts/typecheck-changed.sh",
		"typecheck:vam": "bun x tsc --project tsconfig.vam.json --noEmit",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"workspace:build": "bun ./scripts/workspace-task.ts build",
		"workspace:build-full": "bun ./scripts/workspace-task.ts build-full",
		"workspace:install": "bun ./scripts/workspace-task.ts install"
	},
	"type": "commonjs",
	"version": "0.0.1",
	"workspaces": [
		"src/packages/independent/*",
		"src/packages/composed/*"
	]
}
