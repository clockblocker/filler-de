{
	"$schema": "https://biomejs.dev/schemas/2.2.6/schema.json",
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on",
				"useSortedAttributes": "on",
				"useSortedKeys": "on",
				"useSortedProperties": "on"
			}
		},
		"enabled": true
	},
	"files": {
		"includes": ["**", "!**/.cache", "!.texteater", "!skills-lock.json"]
	},
	"formatter": {
		"attributePosition": "auto",
		"enabled": true,
		"includes": ["**/src/**/*.ts", "**/test/**/*.ts", "./**/*.json"],
		"indentStyle": "tab",
		"indentWidth": 4,
		"lineEnding": "lf",
		"lineWidth": 80
	},
	"linter": {
		"enabled": true,
		"includes": ["**/src/**/*.ts"],
		"rules": {
			"correctness": {
				"noUndeclaredDependencies": "off",
				"useHookAtTopLevel": "off",
				"useImportExtensions": "off"
			},
			"performance": {
				"useTopLevelRegex": "off"
			},
			"recommended": true,
			"style": {
				"noInferrableTypes": "error",
				"noParameterAssign": "error",
				"noRestrictedImports": {
					"level": "error",
					"options": {
						"paths": {
							"zod/v3": "Import zod (v4). Mixing zod v3 and v4 schemas fails at runtime, e.g. in VAM's .extend() and z.codec()."
						}
					}
				},
				"noUnusedTemplateLiteral": "error",
				"noUselessElse": "error",
				"useAsConstAssertion": "error",
				"useDefaultParameterLast": "error",
				"useEnumInitializers": "error",
				"useNamingConvention": "off",
				"useNumberNamespace": "error",
				"useSelfClosingElements": "error",
				"useSingleVarDeclarator": "error"
			},
			"suspicious": {
				"noConsole": "error"
			}
		}
	},
	"vcs": {
		"clientKind": "git",
		"enabled": true,
		"useIgnoreFile": true
	}
}
