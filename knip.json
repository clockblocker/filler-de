{
	"$schema": "https://unpkg.com/knip@5/schema.json",
	"ignoreDependencies": ["ts-plugin-sort-import-suggestions"],
	"ignoreUnresolved": ["./tests/unit/setup.ts"],
	"ignoreIssues": {
		"src/packages/independent/deprecated-lexical-generation/src/internal/prompt-smith/prompt-parts/**/*.ts": [
			"files"
		],
		"src/packages/independent/linguistics/generate-readme/examples/**/*.ts": [
			"files"
		],
		"tests/obsidian-e2e/driver/dist/**/*.js": [
			"files"
		]
	},
	"workspaces": {
		".": {
			"entry": [
				"src/main.ts",
				"scripts/**/*.ts",
				"tests/**/*.test.ts",
				"tests/**/*-runner.ts"
			],
			"project": [
				"src/**/*.ts",
				"scripts/**/*.ts",
				"tests/**/*.ts",
				"!src/packages/**",
				"!tests/obsidian-e2e/driver/dist/**"
			]
		},
		"src/packages/composed/dictionary": {
			"project": ["src/**/*.ts"]
		},
		"src/packages/composed/library-core": {
			"entry": [
				"tests/**/*.test.ts",
				"tests/unit/librarian/library-tree/pipeline/investigate-bulk-event.ts"
			],
			"project": ["src/**/*.ts", "tests/**/*.ts"]
		},
		"src/packages/composed/obsidian-event-layer": {
			"project": ["src/**/*.ts"]
		},
		"src/packages/independent/deprecated-lexical-generation": {
			"entry": ["tests/**/*.test.ts"],
			"project": ["src/**/*.ts", "tests/**/*.ts"]
		},
		"src/packages/composed/lexical-generation": {
			"entry": ["tests/**/*.test.ts"],
			"project": ["src/**/*.ts", "tests/**/*.ts"]
		},
		"src/packages/independent/linguistics": {
			"entry": ["tests/**/*.test.ts"],
			"project": ["src/**/*.ts", "generate-readme/**/*.ts", "tests/**/*.ts"]
		},
		"src/packages/independent/note-addressing": {
			"project": ["src/**/*.ts"]
		},
		"src/packages/independent/vault-action-manager": {
			"entry": ["tests/**/*.ts"],
			"project": ["src/**/*.ts", "tests/**/*.ts"]
		}
	}
}
