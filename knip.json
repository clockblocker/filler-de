{
	"$schema": "https://unpkg.com/knip@5/schema.json",
	"ignoreDependencies": ["@typesafe-ai/sdk", "emoji-regex"],
	"ignoreIssues": {
		"tests/obsidian-e2e/driver/dist/**/*.js": ["files"]
	},
	"ignoreUnresolved": ["./tests/unit/setup.ts"],
	"workspaces": {
		".": {
			"entry": [
				"src/main.ts",
				"scripts/**/*.ts",
				"tests/**/*.test.ts",
				"tests/**/*-runner.ts"
			],
			"project": [
				"src/**/*.ts",
				"scripts/**/*.ts",
				"tests/**/*.ts",
				"!src/packages/**",
				"!tests/obsidian-e2e/driver/dist/**"
			]
		},
		"src/packages/composed/dictionary": {
			"entry": ["tests/**/*.test.ts"],
			"project": ["src/**/*.ts", "tests/**/*.ts"]
		},
		"src/packages/composed/library-core": {
			"entry": [
				"tests/**/*.test.ts",
				"tests/unit/librarian/library-tree/pipeline/investigate-bulk-event.ts"
			],
			"project": ["src/**/*.ts", "tests/**/*.ts"]
		},
		"src/packages/composed/obsidian-event-layer": {
			"project": ["src/**/*.ts"]
		},
		"src/packages/independent/lemma-note-codec": {
			"entry": ["tests/**/*.test.ts"],
			"project": ["src/**/*.ts", "tests/**/*.ts"]
		},
		"src/packages/independent/lemma-note-projections": {
			"entry": ["tests/**/*.test.ts"],
			"project": ["src/**/*.ts", "tests/**/*.ts"]
		},
		"src/packages/independent/note-addressing": {
			"project": ["src/**/*.ts"]
		},
		"src/packages/independent/vault-action-manager": {
			"entry": ["tests/**/*.ts"],
			"project": ["src/**/*.ts", "tests/**/*.ts"]
		}
	}
}
