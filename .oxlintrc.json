{
	"$schema": "./node_modules/@effect/tsgo/oxlint-schema.json",
	"extends": ["./node_modules/@effect/tsgo/oxlint-presets/recommended.json"],
	"ignorePatterns": [
		"**/node_modules/**",
		"repos-for-reference/**",
		".texteater/**",
		".claude/**",
		"main.js",
		"**/dist/**",
		"**/.cache/**",
		"**/tests/**",
		"**/test/**",
		"**/e2e/**",
		"**/testing/**",
		"**/*.test.ts",
		"**/*.spec.ts"
	],
	"overrides": [
		{
			"files": ["src/**"],
			"rules": {
				"effecttsgo/any-unknown-in-error-context": "error",
				"effecttsgo/async-function": "error",
				"effecttsgo/extends-native-error": "error",
				"effecttsgo/floating-effect": "error",
				"effecttsgo/global-console": "error",
				"effecttsgo/global-console-in-effect": "error",
				"effecttsgo/global-date": "error",
				"effecttsgo/global-date-in-effect": "error",
				"effecttsgo/global-error-in-effect-failure": "error",
				"effecttsgo/global-timers": "error",
				"effecttsgo/global-timers-in-effect": "error",
				"effecttsgo/new-promise": "error",
				"effecttsgo/run-effect-inside-effect": "error",
				"effecttsgo/try-catch-in-effect-gen": "error",
				"effecttsgo/unknown-in-effect-catch": "error",
				"typescript/no-floating-promises": "error"
			}
		},
		{
			"files": ["scripts/**"],
			"rules": {
				"effecttsgo/async-function": "off",
				"effecttsgo/global-console": "off"
			}
		}
	],
	"rules": {
		"effecttsgo/any-unknown-in-error-context": "warn",
		"effecttsgo/async-function": "warn",
		"effecttsgo/extends-native-error": "warn",
		"effecttsgo/global-console": "warn",
		"effecttsgo/global-console-in-effect": "warn",
		"effecttsgo/global-date": "warn",
		"effecttsgo/global-date-in-effect": "warn",
		"effecttsgo/global-timers": "warn",
		"effecttsgo/global-timers-in-effect": "warn",
		"effecttsgo/new-promise": "warn",
		"no-restricted-imports": [
			"error",
			{
				"paths": [
					{
						"message": "neverthrow is retired; use Effect's Result.",
						"name": "neverthrow"
					},
					{
						"importNames": [
							"Schema",
							"SchemaAST",
							"SchemaGetter",
							"SchemaIssue",
							"SchemaParser",
							"SchemaRepresentation",
							"SchemaTransformation"
						],
						"message": "Effect Schema is not used; validate with Zod, and define errors with Data.TaggedError (#233).",
						"name": "effect"
					}
				],
				"patterns": [
					{
						"group": ["neverthrow/*"],
						"message": "neverthrow is retired; use Effect's Result."
					},
					{
						"group": [
							"effect/Schema*",
							"effect/unstable/schema",
							"effect/unstable/schema/*"
						],
						"message": "Effect Schema is not used; validate with Zod, and define errors with Data.TaggedError (#233)."
					}
				]
			}
		],
		"no-unused-vars": [
			"warn",
			{
				"argsIgnorePattern": "^_.",
				"ignoreRestSiblings": true,
				"varsIgnorePattern": "^_"
			}
		]
	}
}
