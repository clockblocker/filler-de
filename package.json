{
	"author": "clockblocker",
	"dependencies": {
		"@codemirror/view": "latest",
		"@textfresser/lexical-generation": "workspace:*",
		"@textfresser/library-core": "workspace:*",
		"@textfresser/linguistics": "workspace:*",
		"@textfresser/note-addressing": "workspace:*",
		"@textfresser/obsidian-event-layer": "workspace:*",
		"@textfresser/vault-action-manager": "workspace:*",
		"@types/mocha": "^10.0.10",
		"@types/sbd": "latest",
		"neverthrow": "^8.2.0",
		"openai": "latest",
		"sbd": "latest",
		"ts-plugin-sort-import-suggestions": "^1.0.4",
		"typescript-eslint": "^8.68.0",
		"winston": "latest",
		"zod": "4.3.6"
	},
	"description": "Go trough the german texts, building your own dictionary from your personal contexts",
	"devDependencies": {
		"@biomejs/biome": "^2.2.6",
		"@types/bun": "latest",
		"@types/codemirror": "latest",
		"@types/node": "^18.19.130",
		"@types/tern": "latest",
		"@types/winston": "latest",
		"@typescript-eslint/eslint-plugin": "^8.68.0",
		"@typescript-eslint/parser": "^8.68.0",
		"@typescript/native": "npm:typescript@^7.0.2",
		"builtin-modules": "^5.0.0",
		"bun-types": "^1.3.4",
		"effect": "4.0.0-rc.112",
		"esbuild": "^0.25.11",
		"knip": "^5.82.1",
		"obsidian": "^1.10.2",
		"tslib": "^2.8.1",
		"tsx": "^4.20.6",
		"typescript": "npm:@typescript/typescript6@^6.0.2"
	},
	"keywords": [],
	"license": "MIT",
	"main": "main.js",
	"name": "cbcr-text-eater-de",
	"scripts": {
		"build": "bun run build:root",
		"build:dev": "bun x tsc --noEmit && bun run esbuild.config.mjs development",
		"build:full": "bun run codegen:prompts && bun run build:root",
		"build:root": "bun build ./src/main.ts --outfile=main.js --platform=node --format=cjs --external obsidian --external electron --external @codemirror/*",
		"clearTestLogs": "bun ./tests/tracing/scripts/clear-test-logs.ts",
		"codegen:prompts": "bun run --filter @textfresser/lexical-generation codegen:prompts",
		"coverage": "bun run clearTestLogs && bun test --coverage --preload ./tests/unit/setup.ts",
		"dev": "bun run esbuild.config.mjs",
		"fix": "bun x biome check --write --unsafe . 2>/dev/null || true",
		"knip": "knip",
		"lint": "bun x biome check .",
		"prompt:stability": "bun run --filter @textfresser/lexical-generation prompt:stability",
		"prompt:test": "bun run --filter @textfresser/lexical-generation prompt:test",
		"runbook": "bash scripts/runbook-cli/textfresser-runbook",
		"semantic-diff": "bun scripts/semantic-diff.ts",
		"splitter:run": "bun tests/splitter-runner.ts",
		"test": "bun run test:unit",
		"test:integration": "bun test --preload ./tests/unit/setup.ts src/packages/composed/library-core/tests/integration/ tests/integration/",
		"test:lexical-generation": "bun run clearTestLogs && bun run --filter @textfresser/lexical-generation test",
		"test:obsidian-e2e": "bun run build && bun --env-file=.env.obsidian-e2e --env-file=.env.cli-e2e tests/obsidian-e2e/runner.ts --mode=attached",
		"test:obsidian-e2e:infra": "bun test tests/obsidian-e2e/infra tests/obsidian-e2e/driver --timeout 10000",
		"test:obsidian-e2e:managed": "bun run build && OBSIDIAN_E2E_MODE=managed bun tests/obsidian-e2e/runner.ts",
		"test:provider-acceptance": "bun tests/provider-acceptance/textfresser/run.ts",
		"test:provider-acceptance:preflight": "bun test tests/provider-acceptance/textfresser/preflight.test.ts --path-ignore-patterns='__textfresser_no_ignored_test_paths__/**'",
		"test:unit": "bun run clearTestLogs && bun test --reporter=dot --preload ./tests/unit/setup.ts src/packages/independent/*/tests/ src/packages/composed/*/tests/ tests/unit/ tests/integration/ tests/specs/",
		"typecheck": "bun x tsc --noEmit",
		"typecheck:changed": "bash scripts/typecheck-changed.sh",
		"typecheck:vam": "bun x tsc --project tsconfig.vam.json --noEmit",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"workspace:build": "bun ./scripts/workspace-task.ts build",
		"workspace:build-full": "bun ./scripts/workspace-task.ts build-full",
		"workspace:install": "bun ./scripts/workspace-task.ts install"
	},
	"type": "commonjs",
	"version": "0.0.1",
	"workspaces": [
		"src/packages/independent/*",
		"src/packages/composed/*"
	]
}
